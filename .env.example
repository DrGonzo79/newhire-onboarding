# Optional: enable real Claude-based extraction of accepted offers / onboarding
# forms. Without this, the desk falls back to a deterministic mock parser, so
# the app and demo work fully offline with no API key.
ANTHROPIC_API_KEY=

# Optional: override the extraction model (defaults to claude-opus-4-7).
# For a cheaper/faster prototype, set: claude-haiku-4-5
# NEWHIRE_EXTRACTION_MODEL=claude-opus-4-7
